{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/cabin/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/cabin/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/cabin",
  "projects": {
    "cabin": {
      "type": "application",
      "root": "apps/cabin",
      "entryFile": "main",
      "sourceRoot": "apps/cabin/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cabin/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "admin-gateway": {
      "type": "application",
      "root": "apps/admin-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/admin-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/admin-gateway/tsconfig.app.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "upload": {
      "type": "application",
      "root": "apps/upload",
      "entryFile": "main",
      "sourceRoot": "apps/upload/src",
      "compilerOptions": {
        "tsConfigPath": "apps/upload/tsconfig.app.json"
      }
    }
  }
}